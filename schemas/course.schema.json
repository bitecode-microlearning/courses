{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courses.bitecode.co/schemas/course.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceid", "name", "description", "targetaudience", "learninggoal", "coursetype", "ispublic", "longdescription", "tags", "level"],
  "properties": {
    "sourceid": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 }, "description": { "type": "string", "minLength": 1 },
    "notificationtemplateid": { "type": ["integer", "null"] }, "targetaudience": { "type": "string", "minLength": 1 },
    "learninggoal": { "type": "string", "minLength": 1 }, "avoid": { "type": ["string", "null"] },
    "coursetype": { "type": "string", "minLength": 1 }, "ispublic": { "type": "boolean" },
    "shortermgoal": { "type": ["string", "null"] }, "longdescription": { "type": "string", "minLength": 1 },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "technologyid": { "type": ["integer", "null"] }, "imagekey": { "type": ["string", "null"] },
    "level": { "enum": ["beginner", "intermediate", "advanced"] }
  }
}
